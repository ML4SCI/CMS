{
  "_comment": "DepthViT on CIFAR-100 -- general (non-calorimeter) image-dataset evidence. Budget anchored to its own matched ViT baseline: k_factor=61 gives 5,323,575 params against ViT(D=192,L=12,h=3) at 5,380,132, DepthViT as the SMALLER model. Both counts verified by building the nn.Module. patch_size=4 on 32x32 -> 8x8 token grid; hap_window_size=4 -> 2x2 windows. mlp_dim pinned at 768. n_channels=3 (RGB).",
  "seed": 1234,
  "data": {
    "format": "cifar100",
    "root": "/pscratch/sd/k/krish_m/datasets/cifar100",
    "img_size": 32,
    "n_channels": 3,
    "num_classes": 100,
    "global_batch_size": 512,
    "num_workers": 8,
    "pin_memory": true,
    "persistent_workers": true,
    "rand_augment": null,
    "label_smoothing": 0.0,
    "dataset_size": 50000
  },
  "model": {
    "_comment": "ONLY differences vs configs/jets_150p_5M_90epoch.json: patch_size 10->4, k_factor 90->61, max_image_* 100->32, hap_window_size 5->4.",
    "channel_treatment": "asym",
    "patch_size": 4,
    "k_factor": 61,
    "n_layers": 12,
    "mlp_dim": 768,
    "linear_rank": 16,
    "dropout": 0.0,
    "max_image_height": 32,
    "max_image_width": 32,
    "num_hap_layers": 4,
    "hap_window_size": 4,
    "hap_mlp_ratio": 4.0,
    "hap_drop_path": 0.0,
    "hap_alpha": 0.1,
    "hap_learnable_alpha": false,
    "grad_checkpointing": false,
    "k_chunk_size": 0,
    "compile_blocks": true,
    "compile": false
  },
  "trainer": {
    "_comment": "accumulate_grad_batches=1: 50000/512=97 steps/epoch = _steps_per_epoch().",
    "precision": "bf16-mixed",
    "accumulate_grad_batches": 1,
    "grad_clip_norm": 1.0,
    "devices": 4,
    "strategy": "ddp_find_unused_parameters_true",
    "log_every_n_steps": 20,
    "val_check_interval": 1.0,
    "default_root_dir": "/pscratch/sd/k/krish_m/depthvit/runs/cifar100_dvit_5M_90epoch_seed1234"
  },
  "checkpointing": {
    "dir": "/pscratch/sd/k/krish_m/depthvit/runs/cifar100_dvit_5M_90epoch_seed1234/checkpoints/{phase}",
    "monitor": "val_acc1",
    "mode": "max",
    "save_top_k": 1,
    "every_n_epochs": 1
  },
  "phases": [
    {
      "name": "cls_finetune",
      "type": "cls_finetune",
      "epochs": 90,
      "optim": {
        "optimizer": "sgd",
        "lr": 0.1,
        "weight_decay": 0.0001,
        "momentum": 0.9
      },
      "sched": {
        "sched": "cosine",
        "warmup_steps": 400,
        "min_lr": 1e-06,
        "epochs": 90
      },
      "_comment": "90 epochs, matching every other run. warmup_steps=400 = ~4.1 epochs of warmup, same fraction as jets (5000/1211=4.1ep)."
    }
  ],
  "resume": {
    "start_phase": 0,
    "path": null
  }
}
